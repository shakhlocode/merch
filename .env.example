# Use your NEW Supabase project. Never commit real values or secrets.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server only: required for personal and email invitation activation. Never use NEXT_PUBLIC.
SUPABASE_SERVICE_ROLE_KEY=
# Enable only after configuring corporate SMTP in Supabase Auth.
INVITE_EMAIL_ENABLED=false

# Non-secret release identifiers. CI sets MERCH_RELEASE_ID to the deployed commit SHA.
MERCH_RELEASE_ID=
# Approved origins/commit for npm run security:deployment (read-only, after deploy).
MERCH_EXPECTED_APP_ORIGIN=
MERCH_EXPECTED_SUPABASE_ORIGIN=
MERCH_EXPECTED_RELEASE=
